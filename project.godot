[layer_names]

3d_render/layer_12="held_gadgets"
3d_render/layer_13="own_body"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="props"
3d_physics/layer_4="interactable"
3d_physics/layer_5="demon_limbs"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.015, 0.02, 0.03, 1)
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1

[importer_defaults]

scene={
"gltf/embedded_image_handling": 2
}
texture={
"compress/mode": 2,
"mipmaps/generate": true
}
